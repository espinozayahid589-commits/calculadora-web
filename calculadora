<!DOCTYPE html>
<html>
<head>
<title>Calculadora</title>
</head>
<body>

<h1>Calculadora</h1>

<input type="number" id="n1">
<input type="number" id="n2">

<button onclick="sumar()">Sumar</button>

<script>
function sumar(){
let a = Number(document.getElementById("n1").value);
let b = Number(document.getElementById("n2").value);
alert(a+b);
}
</script>

</body>
</html>
